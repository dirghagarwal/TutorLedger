generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Teacher {
  id            String          @id
  name          String
  email         String?         @unique
  passwordHash  String?
  createdAt     DateTime        @default(now())
  students      Student[]
  sessions      TeacherSession[]
  parentPortals ParentPortal[]
}

model TeacherSession {
  id        String   @id
  teacherId String
  tokenHash String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())
  teacher   Teacher  @relation(fields: [teacherId], references: [id], onDelete: Cascade)
  @@index([teacherId, expiresAt])
}

model ParentPortal {
  id         String    @id
  teacherId  String
  studentId  String
  tokenHash  String    @unique
  showFees   Boolean   @default(false)
  expiresAt  DateTime
  revokedAt  DateTime?
  createdAt  DateTime  @default(now())
  teacher    Teacher   @relation(fields: [teacherId], references: [id], onDelete: Cascade)
  student    Student   @relation(fields: [studentId], references: [id], onDelete: Cascade)
  @@index([teacherId, studentId])
  @@index([studentId, revokedAt])
}

model Student {
  id        String     @id
  teacherId String
  name      String
  subject   String
  feeType   String
  fee       Int
  billingStartMonth String?
  active    Boolean
  color     String
  teacher   Teacher    @relation(fields: [teacherId], references: [id], onDelete: Cascade)
  schedules Schedule[]
  sessions  Session[]
  payments  Payment[]
  parentPortals ParentPortal[]
  @@index([teacherId])
}

model Schedule {
  teacherId String
  id        String    @id
  studentId String
  dayOfWeek String
  startTime String
  endTime   String
  subject   String
  active    Boolean
  student   Student   @relation(fields: [studentId], references: [id], onDelete: Cascade)
  sessions  Session[]
  @@index([studentId])
  @@index([teacherId])
}

model Session {
  teacherId String
  id         String      @id
  studentId  String
  scheduleId String
  date       String
  startTime  String
  endTime    String
  status     String
  startedAt      String?
  endedAt        String?
  durationMinutes Int?
  student    Student     @relation(fields: [studentId], references: [id], onDelete: Cascade)
  schedule   Schedule    @relation(fields: [scheduleId], references: [id], onDelete: Cascade)
  attendance Attendance?
  payments   Payment[]
  paymentAllocations PaymentAllocation[]
  notes      SessionNote[]
  attachments Attachment[]
  @@unique([studentId, date, startTime])
  @@index([studentId, date])
  @@index([scheduleId, date])
  @@index([teacherId])
}

model SessionNote {
  teacherId String
  id        String   @id
  sessionId String
  topic     String
  classwork String
  homework  String
  remarks   String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  session   Session  @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  @@index([sessionId, createdAt])
  @@index([teacherId])
}

model Attachment {
  teacherId String
  id          String   @id
  sessionId   String
  type        String
  filename    String
  storagePath  String
  uploadedAt  DateTime @default(now())
  session     Session  @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  @@index([sessionId, uploadedAt])
  @@index([teacherId])
}

model Attendance {
  teacherId String
  id        String  @id
  sessionId String  @unique
  date      String
  startTime String
  endTime   String
  status    String
  notes     String
  session   Session @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  @@index([teacherId])
}

model Payment {
  teacherId String
  id            String   @id
  studentId     String
  sessionId     String?
  amount        Int
  date          String
  method        String
  status        String
  billingPeriod String
  notes         String
  student       Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)
  session       Session? @relation(fields: [sessionId], references: [id], onDelete: SetNull)
  allocations   PaymentAllocation[]
  @@index([studentId, date])
  @@index([sessionId])
  @@index([teacherId])
}

model PaymentAllocation {
  teacherId String
  id        String  @id
  paymentId String
  sessionId String
  amount    Int
  payment   Payment @relation(fields: [paymentId], references: [id], onDelete: Cascade)
  session   Session @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  @@unique([paymentId, sessionId])
  @@index([sessionId])
  @@index([paymentId])
  @@index([teacherId])
}
